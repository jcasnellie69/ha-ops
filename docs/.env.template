## z/OS 3.2 Migration — GitHub Automation Environment Variables
## Copy this file to .env and fill in your values
## NEVER commit .env to git

# GitHub Personal Access Token
# Required scopes: repo (issues, labels, milestones), project (read/write)
# Create at: https://github.com/settings/tokens/new
GH_TOKEN=ghp_your_personal_access_token_here

# GitHub repository: owner/repo-name
GH_REPO=yourorg/zos-32-migration

# GitHub org login (for org-level project board)
GH_ORG=yourorg

# GitHub username (for user-level project board, if not using org)
# GH_USER=yourusername

# Path to Excel workbook (relative to repo root)
GH_WORKBOOK=excel_report/zos-migration-risk/zos-migration-risk-comparison.xlsx

# GitHub Projects v2 node ID (filled in after running setup_project_board.py)
# Find it in project_board_config.json after setup
GH_PROJECT_ID=PVT_kgDOBxxxxxx